<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.evolunteer.mapper.ParticipationMapper">
    <!-- E志愿志愿者服务平台 V1.0 活动报名表 participate 的映射文件 -->


    <resultMap id="BaseResultMap" type="com.evolunteer.entity.Participation">
            <id property="participateNum" column="participate_num" jdbcType="INTEGER"/>
            <result property="volunteerNum" column="volunteer_num" jdbcType="INTEGER"/>
            <result property="activityNum" column="activity_num" jdbcType="INTEGER"/>
            <result property="participateApplytime" column="participate_applytime" jdbcType="TIMESTAMP"/>
            <result property="participateApplystate" column="participate_applystate" jdbcType="VARCHAR"/>
            <result property="participateApplychecktime" column="participate_applychecktime" jdbcType="TIMESTAMP"/>
            <result property="participateTraining" column="participate_training" jdbcType="VARCHAR"/>
            <result property="participateBegintime" column="participate_begintime" jdbcType="TIMESTAMP"/>
            <result property="participateEndtime" column="participate_endtime" jdbcType="TIMESTAMP"/>
            <result property="participateDuration" column="participate_duration" jdbcType="FLOAT"/>
            <result property="participateTimecheck" column="participate_timecheck" jdbcType="VARCHAR"/>
            <result property="participateNoshow" column="participate_noshow" jdbcType="INTEGER"/>
            <result property="participateCancelTime" column="participate_cancel_time" jdbcType="TIMESTAMP"/>
            <result property="participateIsdeleted" column="participate_isdeleted" jdbcType="INTEGER"/>
    </resultMap>

    <resultMap id="WithVolunteerResultMap" type="com.evolunteer.entity.Participation">
        <id property="participateNum" column="participate_num" jdbcType="INTEGER"/>
        <result property="volunteerNum" column="volunteer_num" jdbcType="INTEGER"/>
        <result property="activityNum" column="activity_num" jdbcType="INTEGER"/>
        <result property="participateApplytime" column="participate_applytime" jdbcType="TIMESTAMP"/>
        <result property="participateApplystate" column="participate_applystate" jdbcType="VARCHAR"/>
        <result property="participateApplychecktime" column="participate_applychecktime" jdbcType="TIMESTAMP"/>
        <result property="participateTraining" column="participate_training" jdbcType="VARCHAR"/>
        <result property="participateBegintime" column="participate_begintime" jdbcType="TIMESTAMP"/>
        <result property="participateEndtime" column="participate_endtime" jdbcType="TIMESTAMP"/>
        <result property="participateDuration" column="participate_duration" jdbcType="FLOAT"/>
        <result property="participateTimecheck" column="participate_timecheck" jdbcType="VARCHAR"/>
        <result property="participateNoshow" column="participate_noshow" jdbcType="INTEGER"/>
        <result property="participateCancelTime" column="participate_cancel_time" jdbcType="TIMESTAMP"/>
        <result property="participateIsdeleted" column="participate_isdeleted" jdbcType="INTEGER"/>
        <association property="volunteer" javaType="com.evolunteer.entity.Volunteer">
            <id property="volunteerNum" column="volunteer_num" jdbcType="INTEGER"/>
            <result property="volunteerId" column="volunteer_id" jdbcType="VARCHAR"/>
            <result property="volunteerName" column="volunteer_name" jdbcType="VARCHAR"/>
            <result property="volunteerRegisterdate" column="volunteer_registerdate" jdbcType="DATE"/>
            <result property="volunteerGender" column="volunteer_gender" jdbcType="VARCHAR"/>
            <result property="volunteerBirth" column="volunteer_birth" jdbcType="DATE"/>
            <result property="volunteerTel" column="volunteer_tel" jdbcType="VARCHAR"/>
            <result property="volunteerCredit" column="volunteer_credit" jdbcType="INTEGER"/>
            <result property="volunteerNoshow" column="volunteer_noshow" jdbcType="INTEGER"/>
            <result property="volunteerTotalduration" column="volunteer_totalduration" jdbcType="FLOAT"/>
        </association>
    </resultMap>

    <!-- 志愿者本人报名记录的查询结果，关联活动信息与最近一次签到信息 -->
    <resultMap id="VolunteerParticipationResultMap" type="com.evolunteer.entity.VolunteerParticipationView">
        <id property="participateNum" column="participate_num" jdbcType="INTEGER"/>
        <result property="activityNum" column="activity_num" jdbcType="INTEGER"/>
        <result property="activityId" column="activity_id" jdbcType="VARCHAR"/>
        <result property="activityName" column="activity_name" jdbcType="VARCHAR"/>
        <result property="activityState" column="activity_state" jdbcType="VARCHAR"/>
        <result property="activityBegintime" column="activity_begintime" jdbcType="TIMESTAMP"/>
        <result property="activityEndtime" column="activity_endtime" jdbcType="TIMESTAMP"/>
        <result property="activityLocation" column="activity_location" jdbcType="VARCHAR"/>
        <result property="participateApplytime" column="participate_applytime" jdbcType="TIMESTAMP"/>
        <result property="participateApplystate" column="participate_applystate" jdbcType="VARCHAR"/>
        <result property="participateDuration" column="participate_duration" jdbcType="FLOAT"/>
        <result property="participateTimecheck" column="participate_timecheck" jdbcType="VARCHAR"/>
        <result property="checkinBegintime" column="checkin_begintime" jdbcType="TIMESTAMP"/>
        <result property="checkinEndtime" column="checkin_endtime" jdbcType="TIMESTAMP"/>
        <result property="checkinDuration" column="checkin_duration" jdbcType="FLOAT"/>
        <result property="checkinDistance" column="checkin_distance" jdbcType="INTEGER"/>
        <result property="checkinFlag" column="checkin_flag" jdbcType="VARCHAR"/>
        <result property="checkinTimecheck" column="checkin_timecheck" jdbcType="VARCHAR"/>
        <result property="checkinRemark" column="checkin_remark" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        participate_num,volunteer_num,activity_num,
        participate_applytime,participate_applystate,participate_applychecktime,
        participate_training,participate_begintime,participate_endtime,
        participate_duration,participate_timecheck,participate_noshow,
        participate_cancel_time,participate_isdeleted
    </sql>
    <sql id="ParticipationWithVolunteer_Column_List">
        participate.participate_num,
        participate.volunteer_num,
        participate.participate_applytime,
        participate.participate_applystate,
        participate.participate_applychecktime,
        participate.activity_num,
        participate.participate_noshow,
        volunteer.volunteer_id,
        volunteer.volunteer_name,
        volunteer.volunteer_gender,
        volunteer.volunteer_birth,
        volunteer.volunteer_tel,
        volunteer.volunteer_credit,
        volunteer.volunteer_noshow,
        volunteer.volunteer_totalduration
    </sql>

    <select id="selectParticipateWithVolunteerByActivityNum" resultMap="WithVolunteerResultMap">
        select
        <include refid="ParticipationWithVolunteer_Column_List"/>
        from participate, volunteer
        where participate.activity_num=#{activityNum,jdbcType=NUMERIC}
        and participate.volunteer_num=volunteer.volunteer_num
        and participate.participate_isdeleted=0
    </select>

    <!-- 查询志愿者本人的报名记录，关联活动信息与最近一次签到信息 -->
    <select id="selectVolunteerParticipations" resultMap="VolunteerParticipationResultMap">
        select
        p.participate_num,
        p.activity_num,
        p.participate_applytime,
        p.participate_applystate,
        p.participate_duration,
        p.participate_timecheck,
        a.activity_id,
        a.activity_name,
        a.activity_state,
        a.activity_begintime,
        a.activity_endtime,
        a.activity_location,
        c.checkin_begintime,
        c.checkin_endtime,
        c.checkin_duration,
        c.checkin_distance,
        c.checkin_flag,
        c.checkin_timecheck,
        c.checkin_remark
        from participate p
        join activity a on a.activity_num = p.activity_num
        left join checkin c on c.checkin_num = (select max(c2.checkin_num)
        from checkin c2
        where c2.participate_num = p.participate_num)
        where p.volunteer_num = #{volunteerNum,jdbcType=INTEGER}
        and p.participate_isdeleted = 0
        order by a.activity_begintime desc, p.participate_num desc
    </select>

    <!-- 查询志愿者经志愿者组织复核通过的服务记录，用于生成志愿服务证明 -->
    <select id="selectApprovedServiceRecords" resultType="com.evolunteer.entity.ServiceRecord">
        select
        a.activity_name as activityName,
        a.activity_id as activityId,
        date_format(a.activity_begintime, '%Y-%m-%d') as serviceDate,
        p.participate_duration as duration
        from participate p
        join activity a on a.activity_num = p.activity_num
        where p.volunteer_num = #{volunteerNum,jdbcType=INTEGER}
        and p.participate_applystate = '1'
        and p.participate_timecheck = '1'
        and p.participate_isdeleted = 0
        order by a.activity_begintime desc
    </select>

    <!-- 调用数据库存储过程 volunteer_apply_activity 完成活动报名 -->
    <insert id="volunteer_apply_activity" statementType="CALLABLE">
        {call volunteer_apply_activity(#{volunteerNum,mode=IN,jdbcType=INTEGER},
                                       #{activityNum,mode=IN,jdbcType=INTEGER},
                                       #{msg,mode=OUT,jdbcType=VARCHAR},
                                       #{ok,mode=OUT,jdbcType=INTEGER})
        }
    </insert>

    <!-- 调用数据库存储过程 volunteer_cancel_participate 完成报名撤回 -->
    <insert id="volunteer_cancel_participate" statementType="CALLABLE">
        {call volunteer_cancel_participate(#{participateNum,mode=IN,jdbcType=INTEGER},
                                           #{volunteerNum,mode=IN,jdbcType=INTEGER},
                                           #{msg,mode=OUT,jdbcType=VARCHAR},
                                           #{ok,mode=OUT,jdbcType=INTEGER})
        }
    </insert>

    <!-- 调用数据库存储过程 organization_check_volunteer 写入报名审核结果 -->
    <insert id="organization_check_volunteer" statementType="CALLABLE">
        {call organization_check_volunteer(#{participateNum,mode=IN,jdbcType=NUMERIC},
                                           #{isPass,mode=IN,jdbcType=NUMERIC},
                                           #{msg,mode=OUT,jdbcType=VARCHAR})
            }
    </insert>

</mapper>
