<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.evolunteer.mapper.OrganizationMapper">
    <!-- E志愿志愿者服务平台 V1.0 志愿者组织表 organization 的映射文件 -->


    <resultMap id="BaseResultMap" type="com.evolunteer.entity.Organization">
            <id property="organizationNum" column="organization_num" jdbcType="INTEGER"/>
            <result property="organizationId" column="organization_id" jdbcType="VARCHAR"/>
            <result property="organizationName" column="organization_name" jdbcType="VARCHAR"/>
            <result property="organizationEstablishdate" column="organization_establishdate" jdbcType="DATE"/>
            <result property="organizationIntroduction" column="organization_introduction" jdbcType="VARCHAR"/>
            <result property="organizationIsdeleted" column="organization_isdeleted" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        organization_num,organization_id,
        organization_name,organization_establishdate,organization_introduction,
        organization_isdeleted
    </sql>
    <select id="selectByOrganizationName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from organization
        where
        organization_name = #{organizationName,jdbcType=VARCHAR}
    </select>

    <select id="selectByOrganizationId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from organization
        where
        organization_id = #{organizationId,jdbcType=VARCHAR}
    </select>
    <update id="updateOrganizationNameAndOrganizationIntroductionByOrganizationId">
update organization
 set organization_name = #{organizationName,jdbcType=VARCHAR},
 organization_introduction = #{organizationIntroduction,jdbcType=VARCHAR}
where
organization_id = #{organizationId,jdbcType=VARCHAR}
</update>

    <!-- 志愿者组织账号名单查询结果：组织信息 + 登录账号状态 + 已申报的活动数量 -->
    <resultMap id="AccountResultMap" type="com.evolunteer.entity.Organization" extends="BaseResultMap">
        <result property="accountEnabled" column="account_enabled" jdbcType="INTEGER"/>
        <result property="activityCount" column="activity_count" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Account_Column_List">
        o.organization_num,o.organization_id,
        o.organization_name,o.organization_establishdate,o.organization_introduction,
        o.organization_isdeleted,u.enabled as account_enabled,
        (select count(*)
        from activity a
        where a.organization_num = o.organization_num
        and a.activity_isdeleted = 0) as activity_count
    </sql>

    <!-- 平台管理员分页查询志愿者组织名单，含已被停用的组织，并关联登录账号状态与已申报的活动数量 -->
    <select id="selectAccountPage" resultMap="AccountResultMap">
        select
        <include refid="Account_Column_List"/>
        from organization o
        left join e_user u on u.id = o.organization_id
        <where>
            <if test="keyword != null and keyword != ''">
                and (o.organization_id like concat('%', #{keyword,jdbcType=VARCHAR}, '%')
                or o.organization_name like concat('%', #{keyword,jdbcType=VARCHAR}, '%'))
            </if>
        </where>
        order by o.organization_num asc
    </select>

    <!-- 查询全部志愿者组织的编号与名称，含已被停用的组织，供活动清单导出回填申报组织名称 -->
    <select id="selectAllOrganizationNumAndName" resultMap="BaseResultMap">
        select organization_num,organization_id,organization_name
        from organization
        order by organization_num asc
    </select>
</mapper>
