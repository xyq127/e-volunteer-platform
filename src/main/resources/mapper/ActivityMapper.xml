<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.evolunteer.mapper.ActivityMapper">

    <resultMap id="BaseResultMap" type="com.evolunteer.entity.Activity">
        <id property="activityNum" column="activity_num" jdbcType="INTEGER"/>
        <result property="organizationNum" column="organization_num" jdbcType="INTEGER"/>
        <result property="activityId" column="activity_id" jdbcType="VARCHAR"/>
        <result property="activityName" column="activity_name" jdbcType="VARCHAR"/>
        <result property="activityDetail" column="activity_detail" jdbcType="VARCHAR"/>
        <result property="activityBegintime" column="activity_begintime" jdbcType="TIMESTAMP"/>
        <result property="activityEndtime" column="activity_endtime" jdbcType="TIMESTAMP"/>
        <result property="activityLocation" column="activity_location" jdbcType="VARCHAR"/>
        <result property="activityNeedpeople" column="activity_needpeople" jdbcType="INTEGER"/>
        <result property="activityNotice" column="activity_notice" jdbcType="VARCHAR"/>
        <result property="activityPublishtime" column="activity_publishtime" jdbcType="TIMESTAMP"/>
        <result property="activitySignddl" column="activity_signddl" jdbcType="TIMESTAMP"/>
        <result property="activityState" column="activity_state" jdbcType="VARCHAR"/>
        <result property="adminNum" column="admin_num" jdbcType="INTEGER"/>
        <result property="activityCheckin" column="activity_checkin" jdbcType="VARCHAR"/>
        <result property="activityLeaderid" column="activity_leaderid" jdbcType="INTEGER"/>
        <result property="activityChecktime" column="activity_checktime" jdbcType="TIMESTAMP"/>
        <result property="activityRemark" column="activity_remark" jdbcType="VARCHAR"/>
        <result property="activityLatitude" column="activity_latitude" jdbcType="DECIMAL"/>
        <result property="activityLongitude" column="activity_longitude" jdbcType="DECIMAL"/>
        <result property="activityRadius" column="activity_radius" jdbcType="INTEGER"/>
        <result property="activityReasonCode" column="activity_reason_code" jdbcType="VARCHAR"/>
        <result property="activityRevision" column="activity_revision" jdbcType="INTEGER"/>
        <result property="activitySettleTime" column="activity_settle_time" jdbcType="TIMESTAMP"/>
        <result property="activityIsdeleted" column="activity_isdeleted" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        activity_num,organization_num,activity_id,
        activity_name,activity_detail,activity_begintime,
        activity_endtime,activity_location,activity_needpeople,
        activity_notice,activity_publishtime,activity_signddl,
        activity_state,admin_num,activity_checkin,
        activity_leaderid,activity_checktime,activity_remark,
        activity_latitude,activity_longitude,
        activity_radius,activity_reason_code,activity_revision,
        activity_settle_time,activity_isdeleted
    </sql>

    <sql id="Keyword_Condition">
        <if test="keyword != null and keyword != ''">
            and (activity_name like concat('%', #{keyword,jdbcType=VARCHAR}, '%')
            or activity_id like concat('%', #{keyword,jdbcType=VARCHAR}, '%')
            or activity_location like concat('%', #{keyword,jdbcType=VARCHAR}, '%'))
        </if>
    </sql>

    <insert id="organization_insert_activity" statementType="CALLABLE">
        {call organization_insert_activity(#{loginId,mode=IN,jdbcType=VARCHAR},
                                           #{activityName,mode=IN,jdbcType=VARCHAR},
                                           #{activityDetail,mode=IN,jdbcType=VARCHAR},
                                           #{activityBegintime,mode=IN,jdbcType=TIMESTAMP},
                                           #{activityEndtime,mode=IN,jdbcType=TIMESTAMP},
                                           #{activityLocation,mode=IN,jdbcType=VARCHAR},
                                           #{activityNeedpeople,mode=IN,jdbcType=INTEGER},
                                           #{activityNotice,mode=IN,jdbcType=VARCHAR},
                                           #{activitySignddl,mode=IN,jdbcType=TIMESTAMP},
                                           #{activitySkillNames,mode=IN,jdbcType=VARCHAR},
                                           #{activityLatitude,mode=IN,jdbcType=DECIMAL},
                                           #{activityLongitude,mode=IN,jdbcType=DECIMAL},
                                           #{activityRadius,mode=IN,jdbcType=INTEGER},
                                           #{msg,mode=OUT,jdbcType=VARCHAR})
        }
    </insert>

    <insert id="admin_check_activity" statementType="CALLABLE">
        {call admin_check_activity(#{loginId,mode=IN,jdbcType=VARCHAR},
                                   #{activityNum,mode=IN,jdbcType=NUMERIC},
                                   #{isPass,mode=IN,jdbcType=NUMERIC},
                                   #{reasonCode,mode=IN,jdbcType=VARCHAR},
                                   #{remark,mode=IN,jdbcType=VARCHAR},
                                   #{msg,mode=OUT,jdbcType=VARCHAR})
        }
    </insert>

    <insert id="organization_revise_activity" statementType="CALLABLE">
        {call organization_revise_activity(#{loginId,mode=IN,jdbcType=VARCHAR},
                                           #{activityNum,mode=IN,jdbcType=NUMERIC},
                                           #{activityName,mode=IN,jdbcType=VARCHAR},
                                           #{activityDetail,mode=IN,jdbcType=VARCHAR},
                                           #{activityBegintime,mode=IN,jdbcType=TIMESTAMP},
                                           #{activityEndtime,mode=IN,jdbcType=TIMESTAMP},
                                           #{activityLocation,mode=IN,jdbcType=VARCHAR},
                                           #{activityNeedpeople,mode=IN,jdbcType=INTEGER},
                                           #{activityNotice,mode=IN,jdbcType=VARCHAR},
                                           #{activitySignddl,mode=IN,jdbcType=TIMESTAMP},
                                           #{activitySkillNames,mode=IN,jdbcType=VARCHAR},
                                           #{activityLatitude,mode=IN,jdbcType=DECIMAL},
                                           #{activityLongitude,mode=IN,jdbcType=DECIMAL},
                                           #{activityRadius,mode=IN,jdbcType=INTEGER},
                                           #{msg,mode=OUT,jdbcType=VARCHAR})
        }
    </insert>

    <insert id="organization_change_activity_state" statementType="CALLABLE">
        {call organization_change_activity_state(#{loginId,mode=IN,jdbcType=VARCHAR},
                                                 #{activityNum,mode=IN,jdbcType=NUMERIC},
                                                 #{targetState,mode=IN,jdbcType=VARCHAR},
                                                 #{msg,mode=OUT,jdbcType=VARCHAR},
                                                 #{ok,mode=OUT,jdbcType=INTEGER})
        }
    </insert>

    <insert id="activity_state_refresh" statementType="CALLABLE">
        {call activity_state_refresh(#{startedCount,mode=OUT,jdbcType=INTEGER},
                                     #{finishedCount,mode=OUT,jdbcType=INTEGER})
        }
    </insert>

    <select id="selectPageByOrganizationAndState" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where organization_num = #{organizationNum,jdbcType=NUMERIC}
        and activity_state = #{activityState,jdbcType=VARCHAR}
        and activity_isdeleted = 0
        <include refid="Keyword_Condition"/>
        order by activity_begintime desc, activity_num desc
    </select>

    <select id="selectPageByState" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where activity_state = #{activityState,jdbcType=VARCHAR}
        and activity_isdeleted = 0
        <include refid="Keyword_Condition"/>
        order by activity_publishtime desc, activity_num desc
    </select>

    <select id="selectAllByOrganizationNumAndActivityStateAndActivityIsdeleted" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where
        organization_num = #{organizationNum,jdbcType=NUMERIC}
        AND activity_state = #{activityState,jdbcType=VARCHAR}
        AND activity_isdeleted = #{activityIsdeleted,jdbcType=NUMERIC}
    </select>

    <select id="selectAllByActivityStateAndActivityIsdeleted" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where
        activity_state = #{activityState,jdbcType=VARCHAR}
        AND activity_isdeleted = #{activityIsdeleted,jdbcType=NUMERIC}
    </select>

    <select id="selectByActivityNum" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where activity_num = #{activityNum,jdbcType=NUMERIC}
    </select>

    <select id="selectAllByActivityName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where activity_name = #{activityName,jdbcType=VARCHAR}
    </select>

    <select id="selectByActivityName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from activity
        where activity_name = #{activityName,jdbcType=VARCHAR}
    </select>

    <update id="updateActivityCheckinSecret">
        update activity
        set activity_checkin_secret = #{activityCheckinSecret,jdbcType=VARCHAR}
        where activity_num = #{activityNum,jdbcType=NUMERIC}
    </update>

    <select id="selectCheckinCodeInfo" resultType="com.evolunteer.entity.CheckinCodeView">
        select
        activity_num as activityNum,
        activity_checkin_code(activity_checkin_secret, activity_num,
        floor(unix_timestamp(now()) / 120)) as checkinCode,
        (120 - (unix_timestamp(now()) % 120)) as expiresInSeconds,
        case when activity_checkin_secret is null then 0 else 1 end as secret_generated
        from activity
        where activity_num = #{activityNum,jdbcType=NUMERIC}
          and activity_isdeleted = 0
    </select>

    <update id="updateActivityIsdeletedByActivityNum">
        update activity
        set activity_isdeleted = #{activityIsdeleted,jdbcType=NUMERIC}
        where
        activity_num = #{activityNum,jdbcType=NUMERIC}
    </update>

</mapper>
